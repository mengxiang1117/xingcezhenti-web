# 文本文件统一 LF，避免 Windows CRLF 提交后 diff 全量变化
*.py    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.htm   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.spec  text eol=lf

# 图片按二进制处理（不换行、不 diff）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
